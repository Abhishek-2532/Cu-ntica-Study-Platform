# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Safe template to commit to Git.
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file — it contains secrets.
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# MongoDB database name
DATABASE_NAME=CUNITICA

# Flask session secret key — MUST be long and random.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_64_char_hex_string

# Google Gemini API key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
# Default model: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
